# Fansly API credentials (from apifansly.com)
FANSLY_API_KEY=your_api_key_here
FANSLY_ACCOUNT_ID=your_fansly_account_id_here

# Creator persona (name of YAML file in config/creators/)
CREATOR_ID=sunny_charm

# Polling (seconds between checking for new messages)
POLL_INTERVAL=30

# Database (SQLite default, or Postgres for production)
DATABASE_URL=sqlite:///data/fansly_bot.db

# Web dashboard port
PORT=8080

# DeepSeek API key (optional — for LLM fact extraction from fan messages)
DEEPSEEK_API_KEY=