# Provider required for fully automated locked PPV and vault browsing
FANSLY_PROVIDER=apifansly
APIFANSLY_API_KEY=replace_me
FANSLY_ACCOUNT_ID=replace_me
# High-entropy route secret used in the APIFansly ppv.purchased webhook URL:
# https://<public-domain>/webhooks/apifansly/<this-token>
APIFANSLY_WEBHOOK_TOKEN=replace_with_at_least_32_random_characters

# Optional rollback credential for OnlyFansAPI's Fansly beta. That provider
# currently cannot send locked PPV and therefore fails launch readiness.
FANSLY_API_KEY=

# Creator persona (name of YAML file in config/creators/)
CREATOR_ID=sunny_charm

# Polling (seconds between checking for new messages). Controlled launch requires
# at least 300 seconds: the chat-list baseline is ~8,640 requests per 30 days,
# before message reads, vault reads, and sends.
POLL_INTERVAL=300

# Idle backoff cap in seconds - how long polling backs off to when no chats
# have unread messages. Resets to POLL_INTERVAL the instant activity resumes.
IDLE_BACKOFF_MAX=600

# Fail-closed launch controls. Keep the bot disabled until a small pilot
# allowlist is configured and explicitly enabled from the dashboard.
CONTROLLED_LAUNCH=true
BOT_ENABLED_DEFAULT=false
FAN_ALLOWLIST=
MAX_MESSAGES_PER_POLL=5

# CRM inbox synchronization is independent from automated replies. Keep it on
# to import every provider conversation, both fan and creator messages, and
# resumable older history while BOT_ENABLED_DEFAULT remains false.
CRM_SYNC_ENABLED=true
# Initial history backfill is finite but consumes one provider credit per
# message page on OnlyFansAPI. Twenty-five 100-message pages per active cycle
# prioritizes making the CRM useful quickly without an unbounded request burst.
CRM_SYNC_MESSAGE_PAGES_PER_CYCLE=25
# The first discovery page is always checked for new activity. A second page
# advances through older chats until every provider conversation is discovered.
CRM_SYNC_DISCOVERY_PAGES_PER_CYCLE=2

# Durable database. PostgreSQL is required in production; SQLite is test/dev only.
DATABASE_URL=postgresql://bot_user:replace_me@localhost:5432/fansly_bot

# Web dashboard port
PORT=8080

# Dashboard authentication (password must be at least 16 characters)
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=replace_with_a_long_random_password

# Optional comma-separated host allowlist. Railway's public/private domains and
# localhost are added automatically.
DASHBOARD_ALLOWED_HOSTS=

# DeepSeek API key (optional - for LLM fact extraction from fan messages)
DEEPSEEK_API_KEY=
