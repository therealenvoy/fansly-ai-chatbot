# Process topology. Keep `all` for the single-service Railway deployment.
# Dedicated api/worker/scheduler services are not created automatically.
SERVICE_ROLE=all

# APIFansly is the only supported Fansly provider.
FANSLY_PROVIDER=apifansly
APIFANSLY_API_KEY=replace_me
FANSLY_ACCOUNT_ID=replace_with_connected_apifansly_account_id
# Random secret of at least 32 characters. Register the resulting endpoint in
# https://app.apifansly.com/webhooks for messages.received, messages.sent, and
# ppv.purchased only.
APIFANSLY_WEBHOOK_TOKEN=
APIFANSLY_WEBHOOK_ENABLED=false

# Creator persona (name of YAML file in config/creators/)
CREATOR_ID=sunny_charm

# Conversation mode replies to unread fans and can start bounded conversations
# when known fans become active. Paid/media delivery is hard-blocked in this mode.
BOT_MODE=conversation
ENABLE_UNREAD_REPLIES=true
ENABLE_ONLINE_OUTREACH=false
ENABLE_STALLED_OUTREACH=false
# First observation establishes a baseline instead of messaging every fan who
# happens to be online when the service starts.
OUTREACH_EXISTING_ONLINE=false
ONLINE_WINDOW_SECONDS=600
PROACTIVE_COOLDOWN_HOURS=48
# Zero means unlimited. The durable episode key still prevents repeated
# stalled follow-ups until the fan replies again.
MAX_PROACTIVE_PER_HOUR=0
MAX_PROACTIVE_PER_DAY=0
MAX_PROACTIVE_PER_FAN_PER_DAY=0
PRESENCE_BATCH_SIZE=100
PRESENCE_POLL_INTERVAL=300
STALLED_AFTER_HOURS=24
STALLED_SCAN_INTERVAL=300
STALLED_SCAN_BATCH_SIZE=5000

# APIFansly webhooks are the primary inbound path. Recovery polling is off by
# default and must stay off for normal operation.
POLL_INTERVAL=300
REPLY_WORKER_COUNT=2
REPLY_WORKER_IDLE_SECONDS=1
RECOVERY_RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL=21600
RECOVERY_CHAT_PAGES_PER_RUN=2
RECOVERY_MESSAGE_PAGES_PER_CHAT=5

# Every provider attempt reserves credit before network I/O. Reads cannot spend
# the send/emergency reserves; a 402 opens a durable circuit until an
# authenticated operator explicitly resets it.
PROVIDER_MONTHLY_CREDIT_LIMIT=20000
PROVIDER_DAILY_READ_CREDIT_LIMIT=50
PROVIDER_MONTHLY_SEND_RESERVE=15000
PROVIDER_MONTHLY_EMERGENCY_RESERVE=2000
# Deterministic human-like delay for new replies and bounded transient retries.
REPLY_DELAY_MIN_SECONDS=5
REPLY_DELAY_MAX_SECONDS=25
PROCESSING_RETRY_BASE_SECONDS=5
PROCESSING_RETRY_MAX_SECONDS=60

# Idle backoff cap in seconds - how long polling backs off to when no chats
# have unread messages. Resets to POLL_INTERVAL the instant activity resumes.
IDLE_BACKOFF_MAX=600

# Fail-closed launch controls. Keep the bot disabled until a small pilot
# allowlist is configured and explicitly enabled from the dashboard.
CONTROLLED_LAUNCH=true
BOT_ENABLED_DEFAULT=false
FAN_ALLOWLIST=
MAX_MESSAGES_PER_POLL=5

# Dashboard list/search/open are local-only. Provider history import is a
# resumable, explicitly enabled backfill with small per-cycle page budgets.
CRM_SYNC_ENABLED=false
CRM_SYNC_MESSAGE_PAGES_PER_CYCLE=5
CRM_SYNC_DISCOVERY_PAGES_PER_CYCLE=1
CRM_SYNC_BACKFILL_INTERVAL=30
CRM_SYNC_INTERVAL=300

# Durable database. PostgreSQL is required in production; SQLite is test/dev only.
DATABASE_URL=postgresql://bot_user:replace_me@localhost:5432/fansly_bot

# Web dashboard port
PORT=8080

# Dashboard authentication (password must be at least 16 characters)
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=replace_with_a_long_random_password
VA_DASHBOARD_USER=
VA_DASHBOARD_PASSWORD=

# Optional comma-separated host allowlist. Railway's public/private domains and
# localhost are added automatically.
DASHBOARD_ALLOWED_HOSTS=

# DeepSeek can be supplied here initially, then replaced from the authenticated
# CRM Settings page. Saved CRM credentials are encrypted before entering the DB.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Required before the CRM can save API credentials. Generate one stable random
# value of at least 32 characters and keep it in the server secret manager.
CREDENTIAL_ENCRYPTION_KEY=


# Conversation Brain 2.0 (safe pre-live defaults)
BRAIN_MODE=shadow
BRAIN_VERSION=brain2-v2
BRAIN_SHADOW_SAMPLE_PERCENT=10
BRAIN_MAX_SHADOW_SAMPLE_PERCENT=100
BRAIN_ALLOW_ADVANCED_SEND=false
BRAIN_OPERATOR_PROMOTION_OVERRIDE=false
BRAIN_LIVE_PERCENT=0
BRAIN_MAX_LIVE_PERCENT=0
BRAIN_AUTO_ROLLBACK=true
BRAIN_LIVE_TIMEOUT_SECONDS=8
BRAIN_MAX_DAILY_COST=0
BRAIN_MAX_STRATEGIC_CALLS_PER_HOUR=25
BRAIN_MAX_STRATEGIC_CALLS_PER_DAY=100
BRAIN_MAX_MODEL_CALLS_PER_TURN=4
BRAIN_MAX_OUTPUT_TOKENS=800
BRAIN_JSON_REPAIR_ATTEMPTS=1

# Human Delivery / Voice Lab (inert foundations; no live authority)
HUMAN_DELIVERY_ENABLED=false
HUMAN_DELIVERY_MODE=off
HUMAN_DELIVERY_SHADOW_PERCENT=0
HUMAN_DELIVERY_LIVE_PERCENT=0
HUMAN_DELIVERY_MAX_LIVE_PERCENT=0
HUMAN_DELIVERY_ALLOW_MULTI_BUBBLE_SEND=false
HUMAN_DELIVERY_MAX_BUBBLES=3
HUMAN_DELIVERY_AVG_BUBBLE_BUDGET=1.35
HUMAN_DELIVERY_TURN_DEBOUNCE_SECONDS=4
HUMAN_DELIVERY_TURN_MAX_WINDOW_SECONDS=12
HUMAN_DELIVERY_CASING_MODE=mostly_lowercase
HUMAN_DELIVERY_ALLOW_TYPOS=false
HUMAN_DELIVERY_PROMPT_COMPILER=false
HUMAN_DELIVERY_MEMORY_V2=false
HUMAN_DELIVERY_ADVANCED_CANDIDATES=false

# Conversation Intelligence V3 (independent ceilings; shadow has no send path)
PLAYBOOK_ENGINE_MODE=off
RELATIONSHIP_STATE_V2_MODE=off
MEMORY_RETRIEVAL_V3_MODE=off
STRATEGY_PLANNER_V2_MODE=off
GLOBAL_DIVERSITY_MODE=off
OUTCOME_LEARNING_MODE=off
MULTI_BUBBLE_MODE=off
CONVERSATION_INTELLIGENCE_V3_ALLOW_SEND=false
CONVERSATION_INTELLIGENCE_V3_SHADOW_PERCENT=0
CONVERSATION_INTELLIGENCE_V3_LIVE_PERCENT=0
CONVERSATION_INTELLIGENCE_V3_MAX_LIVE_PERCENT=0
CONVERSATION_INTELLIGENCE_V3_MAX_DAILY_COST=0
CONVERSATION_INTELLIGENCE_V3_MODEL=deepseek-v4-flash
CONVERSATION_INTELLIGENCE_V3_MAX_OUTPUT_TOKENS=2000
